# Copia a .env (NO se sube a git). En GitHub van como Secrets / Variables.

# --- Gmail (salen de get_refresh_token.py) ---
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=

# --- Quién es importante ---
MY_EMAIL=tu@empresa.com
VIP_SENDERS=jefe@empresa.com
IMPORTANT_DOMAINS=empresa.com,cliente1.com,cliente2.com
# extra ruido (se suma a la lista por defecto: noreply, sandbox, linear, stripe, apple...)
NOISE_SENDERS=proveedor-ruidoso.com
NOISE_KEYWORDS=

# --- Avisos (usa uno o varios) ---
# Slack con bot (recomendado: el bot te escribe por DM y SÍ suena)
SLACK_BOT_TOKEN=
SLACK_CHANNEL=UXXXXXXXXXX
# o Slack incoming webhook
SLACK_WEBHOOK_URL=
# Push al celular con la app ntfy (gratis): inventa un topic largo y secreto
NTFY_TOPIC=
